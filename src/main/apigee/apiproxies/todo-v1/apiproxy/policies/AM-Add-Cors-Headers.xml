<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-Add-Cors-Headers">
    <DisplayName>Add CORS Headers</DisplayName>
    <Set>
        <Headers>
            <Header name="Access-Control-Allow-Origin">*</Header>
            <Header name="Access-Control-Allow-Methods">GET, POST, PUT, PATCH, DELETE, OPTIONS</Header>
            <Header name="Access-Control-Allow-Headers">Authorization, Content-Type, Idempotency-Key, X-Requested-With</Header>
            <Header name="Access-Control-Max-Age">3600</Header>
        </Headers>
    </Set>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <AssignTo createNew="false" transport="http" type="response"/>
</AssignMessage>
