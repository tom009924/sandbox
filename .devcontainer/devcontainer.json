{
  "name": "Kotlin Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces,type=bind",
  "workspaceFolder": "/workspaces",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": true,
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "fwcd.kotlin",
        "vscjava.vscode-java-pack",
        "vscjava.vscode-gradle",
        "Google.google-antigravity",
        "stoplight.spectral",
        "AquaSecurityOfficial.trivy-vulnerability-scanner"
      ],
      "settings": {
        "java.import.gradle.java.home": "/usr/lib/jvm/msopenjdk-current",
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-21",
            "path": "/usr/lib/jvm/msopenjdk-current",
            "default": true
          }
        ]
      }
    }
  },
  "remoteEnv": {
    "GIT_TERMINAL_PROMPT": "0"
  },
  "postCreateCommand": "bash -c 'if [ -f gradlew ]; then ./gradlew detekt buildHealth lintOpenApi --no-daemon; fi'",
  "remoteUser": "vscode"
}
