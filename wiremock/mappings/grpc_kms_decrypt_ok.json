{
  "request": {
    "customMatcher": {
      "name": "grpc",
      "parameters": {
        "service": "com.example.crypto.v1.KeyManagementService",
        "method": "Decrypt",
        "jsonEquals": {
          "keyName": "projects/todo/keys/task-key"
        }
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "grpc-status-name": "OK"
    },
    "bodyFileName": "grpc/kms_decrypt_response.json"
  }
}
